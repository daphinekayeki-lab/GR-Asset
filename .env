# ─────────────────────────────────────────────────────────
#  GR AMS — Email Configuration
#  Fill in your real values then save
#  Run  python test_email.py  to confirm it works
# ─────────────────────────────────────────────────────────

# Your Outlook / Office 365 email address
MAIL_USERNAME=yourname@gr.org

# Your password — if MFA is ON use an App Password instead
# Generate one at: https://mysignins.microsoft.com/security-info
MAIL_PASSWORD=your-outlook-password

# SMTP settings — try 587 first, switch to 465 if 587 is blocked
MAIL_SERVER=smtp.office365.com
MAIL_PORT=587
MAIL_USE_SSL=false

# If port 587 AND 465 are both blocked, try Gmail:
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_SSL=false
# MAIL_USERNAME=yourgmail@gmail.com
# MAIL_PASSWORD=your-gmail-app-password

# The URL users will see in their welcome email
# Use your computer name so it works across the office network
APP_URL=http://GRG123456:5000

# Organisation name shown in emails
ORG_NAME=GR
